			<string>%lld Punkt verdient Aufmerksamkeit</string>
			<key>other</key>
			<string>%lld Punkte verdienen Aufmerksamkeit</string>
		</dict>
	</dict>
	<key>%lld расширений</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Erweiterung</string>
			<key>other</key>
			<string>%lld Erweiterungen</string>
		</dict>
	</dict>
	<key>%lld сайтов</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Website</string>
			<key>other</key>
			<string>%lld Websites</string>
		</dict>
	</dict>
	<key>%lld сайтов больше не смогут</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
