			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Punkt</string>
			<key>other</key>
			<string>%lld Punkte</string>
		</dict>
	</dict>
	<key>%lld пунктов стоит</key>
