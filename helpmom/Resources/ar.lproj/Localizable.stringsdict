			<string>lld</string>
			<key>few</key>
			<string>%lld أيام</string>
			<key>many</key>
			<string>%lld يومًا</string>
			<key>one</key>
			<string>يوم واحد</string>
			<key>other</key>
			<string>%lld يوم</string>
			<key>two</key>
			<string>يومين</string>
			<key>zero</key>
			<string>%lld يوم</string>
		</dict>
	</dict>
	<key>%lld раз</key>
