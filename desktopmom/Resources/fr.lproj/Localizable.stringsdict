<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld дней назад</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>il y a %lld jour</string>
			<key>other</key>
			<string>il y a %lld jours</string>
		</dict>
	</dict>
	<key>%lld записей</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld entrée</string>
			<key>other</key>
			<string>%lld entrées</string>
		</dict>
	</dict>
	<key>%lld лет назад</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>il y a %lld an</string>
			<key>other</key>
			<string>il y a %lld ans</string>
		</dict>
	</dict>
	<key>%lld месяцев назад</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>il y a %lld mois</string>
			<key>other</key>
			<string>il y a %lld mois</string>
		</dict>
	</dict>
	<key>%lld снимков и записей экрана, %@.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@, %@.</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld capture ou enregistrement d’écran</string>
			<key>other</key>
			<string>%lld captures et enregistrements d’écran</string>
		</dict>
	</dict>
	<key>%lld снимков экрана (подпись)</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>capture d’écran</string>
			<key>other</key>
			<string>captures d’écran</string>
		</dict>
	</dict>
	<key>%lld файлов</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld fichier</string>
			<key>other</key>
			<string>%lld fichiers</string>
		</dict>
	</dict>
	<key>Переложено %lld объектов в «%@». Вернуть можно в журнале.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld élément rangé dans « %@ ». Vous pouvez le remettre depuis le journal.</string>
			<key>other</key>
			<string>%lld éléments rangés dans « %@ ». Vous pouvez les remettre depuis le journal.</string>
		</dict>
	</dict>
	<key>Переложено %lld снимков экрана в «%@». Вернуть можно в журнале.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld capture d’écran rangée dans « %@ ». Vous pouvez la remettre depuis le journal.</string>
			<key>other</key>
			<string>%lld captures d’écran rangées dans « %@ ». Vous pouvez les remettre depuis le journal.</string>
		</dict>
	</dict>
	<key>Разложить %lld снимков экрана?</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Ranger %lld capture d’écran ?</string>
			<key>other</key>
			<string>Ranger %lld captures d’écran ?</string>
		</dict>
	</dict>
	<key>Убрать со стола %lld объектов?</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Ranger %lld élément du Bureau ?</string>
			<key>other</key>
			<string>Ranger %lld éléments du Bureau ?</string>
		</dict>
	</dict>
	<key>и ещё %lld месяцев</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>et %lld mois de plus</string>
			<key>other</key>
			<string>et %lld mois de plus</string>
		</dict>
	</dict>
</dict>
</plist>
