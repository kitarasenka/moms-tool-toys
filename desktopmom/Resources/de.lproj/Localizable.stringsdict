<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld дней назад</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>vor %lld Tag</string>
			<key>other</key>
			<string>vor %lld Tagen</string>
		</dict>
	</dict>
	<key>%lld записей</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Eintrag</string>
			<key>other</key>
			<string>%lld Einträge</string>
		</dict>
	</dict>
	<key>%lld лет назад</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>vor %lld Jahr</string>
			<key>other</key>
			<string>vor %lld Jahren</string>
		</dict>
	</dict>
	<key>%lld месяцев назад</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>vor %lld Monat</string>
			<key>other</key>
			<string>vor %lld Monaten</string>
		</dict>
	</dict>
	<key>%lld снимков и записей экрана, %@.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@, %@.</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Bildschirmfoto bzw. -aufnahme</string>
			<key>other</key>
			<string>%lld Bildschirmfotos und -aufnahmen</string>
		</dict>
	</dict>
	<key>%lld снимков экрана (подпись)</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Bildschirmfoto</string>
			<key>other</key>
			<string>Bildschirmfotos</string>
		</dict>
	</dict>
	<key>%lld файлов</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Datei</string>
			<key>other</key>
			<string>%lld Dateien</string>
		</dict>
	</dict>
	<key>Переложено %lld объектов в «%@». Вернуть можно в журнале.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Objekt nach „%@“ verschoben. Zurücklegen kannst du es im Protokoll.</string>
			<key>other</key>
			<string>%lld Objekte nach „%@“ verschoben. Zurücklegen kannst du sie im Protokoll.</string>
		</dict>
	</dict>
	<key>Переложено %lld снимков экрана в «%@». Вернуть можно в журнале.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Bildschirmfoto nach „%@“ verschoben. Zurücklegen kannst du es im Protokoll.</string>
			<key>other</key>
			<string>%lld Bildschirmfotos nach „%@“ verschoben. Zurücklegen kannst du sie im Protokoll.</string>
		</dict>
	</dict>
	<key>Разложить %lld снимков экрана?</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Bildschirmfoto einsortieren?</string>
			<key>other</key>
			<string>%lld Bildschirmfotos einsortieren?</string>
		</dict>
	</dict>
	<key>Убрать со стола %lld объектов?</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Objekt vom Schreibtisch wegräumen?</string>
			<key>other</key>
			<string>%lld Objekte vom Schreibtisch wegräumen?</string>
		</dict>
	</dict>
	<key>и ещё %lld месяцев</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>und %lld weiterer Monat</string>
			<key>other</key>
			<string>und %lld weitere Monate</string>
		</dict>
	</dict>
</dict>
</plist>
